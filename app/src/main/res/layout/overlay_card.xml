<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayCard"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="#F4F7F4"
    android:elevation="10dp"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlayTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TradeLens analysis"
            android:textColor="#14221F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/onDeviceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#DDECE5"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="ON-DEVICE"
            android:textColor="#1D6F5A"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/overlayProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/overlayDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#263A35"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/overlayClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:text="Dismiss"
        android:textColor="#1D6F5A"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
